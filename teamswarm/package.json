{
  "name": "teamswarm",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run build",
    "start": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "format:check": "prettier --check src vite.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.577.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "license": "Apache-2.0"
}
